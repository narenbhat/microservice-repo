# Frontend Environment Variables - Production Configuration
# Copy this file to .env.local for development or .env.production for production

# API Configuration
REACT_APP_API_URL=http://localhost:8080
REACT_APP_WS_URL=ws://localhost:8080/ws

# TURN Server Configuration (Required for production)
# Get TURN server credentials from providers like:
# - Twilio (https://www.twilio.com/stun-turn)
# - Xirsys (https://xirsys.com/)
# - coturn (self-hosted)
REACT_APP_TURN_SERVER=turn.example.com
REACT_APP_TURN_USERNAME=your-username
REACT_APP_TURN_CREDENTIAL=your-credential

# Additional TURN servers (optional, comma-separated)
REACT_APP_TURN_SERVERS=turn:turn1.example.com:3478,turn:turn2.example.com:3478

# WebRTC Configuration
REACT_APP_ICE_TRANSPORT_POLICY=all  # Options: all, relay
REACT_APP_DEFAULT_VIDEO_QUALITY=MEDIUM  # Options: HIGH, MEDIUM, LOW

# Feature Flags
REACT_APP_ENABLE_SCREEN_SHARE=true
REACT_APP_ENABLE_RECORDING=false
REACT_APP_ENABLE_CHAT=true
REACT_APP_MAX_PARTICIPANTS=50

# Analytics and Monitoring (Optional)
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_SENTRY_DSN=
REACT_APP_GA_TRACKING_ID=

# Environment
REACT_APP_ENV=development  # Options: development, staging, production

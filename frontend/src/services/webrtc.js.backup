// Production-grade ICE configuration with TURN servers
const ICE_SERVERS = {
  iceServers: [
    // Public STUN servers
    { urls: 'stun:stun.l.google.com:19302' },
    { urls: 'stun:stun1.l.google.com:19302' },
    { urls: 'stun:stun2.l.google.com:19302' },
    { urls: 'stun:stun3.l.google.com:19302' },
    { urls: 'stun:stun4.l.google.com:19302' },
    // TURN servers for production (replace with your own TURN servers)
    // Uncomment and configure when deploying to production
    // {
    //   urls: 'turn:your-turn-server.com:3478',
    //   username: process.env.REACT_APP_TURN_USERNAME,
    //   credential: process.env.REACT_APP_TURN_CREDENTIAL
    // },
    // {
    //   urls: 'turns:your-turn-server.com:5349',
    //   username: process.env.REACT_APP_TURN_USERNAME,
    //   credential: process.env.REACT_APP_TURN_CREDENTIAL
    // }
  ],
  iceCandidatePoolSize: 10,
  iceTransportPolicy: 'all', // Use 'relay' to force TURN for testing
  bundlePolicy: 'max-bundle',
  rtcpMuxPolicy: 'require'
};

// Configuration constants
const CONFIG = {
  MAX_RETRY_ATTEMPTS: 3,
  RETRY_DELAY: 2000,
  CONNECTION_TIMEOUT: 30000,
  ICE_GATHERING_TIMEOUT: 10000,
  RECONNECT_DELAY: 3000
};

class WebRTCService {
  constructor() {
    this.peerConnections = new Map();
    this.localStream = null;
    this.screenStream = null;
    this.onRemoteStreamCallback = null;
    this.onRemoteStreamRemovedCallback = null;
    this.onConnectionStateChangeCallback = null;
    this.onNetworkQualityChangeCallback = null;
    this.retryAttempts = new Map();
    this.connectionTimers = new Map();
    this.qualityMonitors = new Map();
    this.isInitialized = false;
  }

  async getLocalStream(constraints = null) {
    try {
      const defaultConstraints = {
        video: {
          width: { ideal: 1280, max: 1920 },
          height: { ideal: 720, max: 1080 },
          frameRate: { ideal: 30, max: 30 },
          facingMode: 'user'
        },
        audio: {
          echoCancellation: true,
          noiseSuppression: true,
          autoGainControl: true,
          sampleRate: 48000
        }
      };

      this.localStream = await navigator.mediaDevices.getUserMedia(
        constraints || defaultConstraints
      );

      this.isInitialized = true;
      this.logInfo('Local media stream acquired successfully');

      return this.localStream;
    } catch (error) {
      this.logError('Error accessing media devices', error);

      // Try fallback with lower quality
      if (!constraints) {
        try {
          this.logInfo('Attempting fallback with lower quality settings');
          return await this.getLocalStream({
            video: { width: 640, height: 480 },
            audio: true
          });
        } catch (fallbackError) {
          this.logError('Fallback also failed', fallbackError);
        }
      }

      throw new Error(`Media access failed: ${error.message}`);
    }
  }

  async getScreenStream() {
    try {
      this.screenStream = await navigator.mediaDevices.getDisplayMedia({
        video: {
          cursor: 'always',
          displaySurface: 'monitor',
          width: { ideal: 1920 },
          height: { ideal: 1080 },
          frameRate: { ideal: 30 }
        },
        audio: {
          echoCancellation: true,
          noiseSuppression: true,
          autoGainControl: true
        }
      });

      // Handle screen share stop button
      this.screenStream.getVideoTracks()[0].addEventListener('ended', () => {
        this.stopScreenShare();
      });

      this.logInfo('Screen sharing started successfully');
      return this.screenStream;
    } catch (error) {
      this.logError('Error accessing screen share', error);
      throw new Error(`Screen share failed: ${error.message}`);
    }
  }

  async replaceVideoTrack(peerId, newTrack) {
    const peerConnection = this.peerConnections.get(peerId);
    if (!peerConnection) return;

    try {
      const sender = peerConnection.getSenders().find(s => s.track?.kind === 'video');
      if (sender) {
        await sender.replaceTrack(newTrack);
        this.logInfo(`Video track replaced for peer ${peerId}`);
      }
    } catch (error) {
      this.logError(`Error replacing video track for ${peerId}`, error);
    }
  }

  async startScreenShare() {
    try {
      const screenStream = await this.getScreenStream();
      const screenTrack = screenStream.getVideoTracks()[0];

      // Replace video track for all peers
      for (const [peerId] of this.peerConnections) {
        await this.replaceVideoTrack(peerId, screenTrack);
      }

      return screenStream;
    } catch (error) {
      this.logError('Failed to start screen share', error);
      throw error;
    }
  }

  async stopScreenShare() {
    if (this.screenStream) {
      this.screenStream.getTracks().forEach(track => track.stop());
      this.screenStream = null;
    }

    if (this.localStream) {
      const videoTrack = this.localStream.getVideoTracks()[0];

      // Restore camera for all peers
      for (const [peerId] of this.peerConnections) {
        await this.replaceVideoTrack(peerId, videoTrack);
      }
    }

    this.logInfo('Screen sharing stopped');
  }

  createPeerConnection(peerId, sendSignal) {
    try {
      const peerConnection = new RTCPeerConnection(ICE_SERVERS);
      this.peerConnections.set(peerId, peerConnection);
      this.retryAttempts.set(peerId, 0);

      // Add local stream tracks to peer connection
      if (this.localStream) {
        this.localStream.getTracks().forEach(track => {
          const sender = peerConnection.addTrack(track, this.localStream);
          this.logInfo(`Added ${track.kind} track for peer ${peerId}`);

          // Monitor track quality
          if (track.kind === 'video') {
            this.startQualityMonitoring(peerId, sender);
          }
        });
      }

      // Handle incoming remote stream
      peerConnection.ontrack = (event) => {
        this.logInfo(`Received remote ${event.track.kind} track from ${peerId}`);
        if (this.onRemoteStreamCallback) {
          this.onRemoteStreamCallback(peerId, event.streams[0]);
        }
      };

      // Handle ICE candidates with buffering
      const iceCandidateBuffer = [];
      let iceGatheringComplete = false;

      peerConnection.onicecandidate = (event) => {
        if (event.candidate) {
          iceCandidateBuffer.push(event.candidate);
          sendSignal({
            type: 'ice-candidate',
            to: peerId,
            data: event.candidate
          });
          this.logInfo(`Sent ICE candidate to ${peerId}`);
        } else {
          iceGatheringComplete = true;
          this.logInfo(`ICE gathering complete for ${peerId}`);
        }
      };

      // Handle ICE connection state changes
      peerConnection.oniceconnectionstatechange = () => {
        this.logInfo(`ICE connection state with ${peerId}: ${peerConnection.iceConnectionState}`);

        switch (peerConnection.iceConnectionState) {
          case 'connected':
          case 'completed':
            this.clearConnectionTimer(peerId);
            this.retryAttempts.set(peerId, 0);
            this.notifyConnectionStateChange(peerId, 'connected');
            break;

          case 'disconnected':
            this.logWarning(`Connection disconnected with ${peerId}, attempting to reconnect`);
            this.handleDisconnection(peerId, sendSignal);
            break;

          case 'failed':
            this.logError(`Connection failed with ${peerId}`);
            this.handleConnectionFailure(peerId, sendSignal);
            break;

          case 'closed':
            this.logInfo(`Connection closed with ${peerId}`);
            this.removePeerConnection(peerId);
            break;

          default:
            break;
        }
      };

      // Handle connection state changes
      peerConnection.onconnectionstatechange = () => {
        this.logInfo(`Connection state with ${peerId}: ${peerConnection.connectionState}`);

        if (this.onConnectionStateChangeCallback) {
          this.onConnectionStateChangeCallback(peerId, peerConnection.connectionState);
        }

        if (peerConnection.connectionState === 'failed') {
          this.handleConnectionFailure(peerId, sendSignal);
        }
      };

      // Handle ICE gathering state
      peerConnection.onicegatheringstatechange = () => {
        this.logInfo(`ICE gathering state with ${peerId}: ${peerConnection.iceGatheringState}`);
      };

      // Handle signaling state changes
      peerConnection.onsignalingstatechange = () => {
        this.logInfo(`Signaling state with ${peerId}: ${peerConnection.signalingState}`);
      };

      // Handle negotiation needed
      peerConnection.onnegotiationneeded = async () => {
        this.logInfo(`Negotiation needed with ${peerId}`);
        // Auto-renegotiation will be handled by createOffer
      };

      // Set connection timeout
      this.setConnectionTimeout(peerId);

      this.logInfo(`Peer connection created for ${peerId}`);
      return peerConnection;
    } catch (error) {
      this.logError(`Failed to create peer connection for ${peerId}`, error);
      throw error;
    }
  }

  setConnectionTimeout(peerId) {
    const timer = setTimeout(() => {
      const pc = this.peerConnections.get(peerId);
      if (pc && pc.connectionState !== 'connected') {
        this.logWarning(`Connection timeout for ${peerId}`);
        this.handleConnectionFailure(peerId, null);
      }
    }, CONFIG.CONNECTION_TIMEOUT);

    this.connectionTimers.set(peerId, timer);
  }

  clearConnectionTimer(peerId) {
    const timer = this.connectionTimers.get(peerId);
    if (timer) {
      clearTimeout(timer);
      this.connectionTimers.delete(peerId);
    }
  }

  async handleDisconnection(peerId, sendSignal) {
    const attempts = this.retryAttempts.get(peerId) || 0;

    if (attempts < CONFIG.MAX_RETRY_ATTEMPTS) {
      this.retryAttempts.set(peerId, attempts + 1);
      this.logInfo(`Attempting reconnection ${attempts + 1}/${CONFIG.MAX_RETRY_ATTEMPTS} for ${peerId}`);

      setTimeout(() => {
        const pc = this.peerConnections.get(peerId);
        if (pc && sendSignal) {
          // Trigger ICE restart
          this.createOffer(peerId, sendSignal, true);
        }
      }, CONFIG.RECONNECT_DELAY);
    } else {
      this.logError(`Max reconnection attempts reached for ${peerId}`);
      this.removePeerConnection(peerId);
    }
  }

  async handleConnectionFailure(peerId, sendSignal) {
    const attempts = this.retryAttempts.get(peerId) || 0;

    if (attempts < CONFIG.MAX_RETRY_ATTEMPTS && sendSignal) {
      this.retryAttempts.set(peerId, attempts + 1);
      this.logInfo(`Retrying connection ${attempts + 1}/${CONFIG.MAX_RETRY_ATTEMPTS} for ${peerId}`);

      // Close existing connection
      const oldPc = this.peerConnections.get(peerId);
      if (oldPc) {
        oldPc.close();
      }

      setTimeout(() => {
        // Create new connection and offer
        this.createPeerConnection(peerId, sendSignal);
        this.createOffer(peerId, sendSignal);
      }, CONFIG.RETRY_DELAY);
    } else {
      this.logError(`Connection permanently failed for ${peerId}`);
      this.removePeerConnection(peerId);
    }
  }

  notifyConnectionStateChange(peerId, state) {
    if (this.onConnectionStateChangeCallback) {
      this.onConnectionStateChangeCallback(peerId, state);
    }
  }

  async createOffer(peerId, sendSignal, iceRestart = false) {
    const peerConnection = this.peerConnections.get(peerId) ||
                          this.createPeerConnection(peerId, sendSignal);

    try {
      const offerOptions = {
        offerToReceiveAudio: true,
        offerToReceiveVideo: true,
        iceRestart: iceRestart
      };

      this.logInfo(`Creating offer for ${peerId}${iceRestart ? ' with ICE restart' : ''}`);

      const offer = await peerConnection.createOffer(offerOptions);
      await peerConnection.setLocalDescription(offer);

      sendSignal({
        type: 'offer',
        to: peerId,
        data: offer
      });

      this.logInfo(`Offer sent to ${peerId}`);
    } catch (error) {
      this.logError(`Error creating offer for ${peerId}`, error);
      throw error;
    }
  }

  async handleOffer(peerId, offer, sendSignal) {
    const peerConnection = this.peerConnections.get(peerId) ||
                          this.createPeerConnection(peerId, sendSignal);

    try {
      this.logInfo(`Handling offer from ${peerId}`);

      // Check if we need to handle signaling state
      if (peerConnection.signalingState !== 'stable') {
        this.logWarning(`Signaling state is ${peerConnection.signalingState}, rolling back`);
        await Promise.all([
          peerConnection.setLocalDescription({ type: 'rollback' }),
          peerConnection.setRemoteDescription(new RTCSessionDescription(offer))
        ]);
      } else {
        await peerConnection.setRemoteDescription(new RTCSessionDescription(offer));
      }

      const answer = await peerConnection.createAnswer();
      await peerConnection.setLocalDescription(answer);

      sendSignal({
        type: 'answer',
        to: peerId,
        data: answer
      });

      this.logInfo(`Answer sent to ${peerId}`);
    } catch (error) {
      this.logError(`Error handling offer from ${peerId}`, error);
      throw error;
    }
  }

  async handleAnswer(peerId, answer) {
    const peerConnection = this.peerConnections.get(peerId);
    if (!peerConnection) {
      this.logWarning(`No peer connection found for ${peerId} when handling answer`);
      return;
    }

    try {
      this.logInfo(`Handling answer from ${peerId}`);
      await peerConnection.setRemoteDescription(new RTCSessionDescription(answer));
      this.logInfo(`Answer processed from ${peerId}`);
    } catch (error) {
      this.logError(`Error handling answer from ${peerId}`, error);
      throw error;
    }
  }

  async handleIceCandidate(peerId, candidate) {
    const peerConnection = this.peerConnections.get(peerId);
    if (!peerConnection) {
      this.logWarning(`No peer connection found for ${peerId} when handling ICE candidate`);
      return;
    }

    try {
      // Only add ICE candidate if remote description is set
      if (peerConnection.remoteDescription) {
        await peerConnection.addIceCandidate(new RTCIceCandidate(candidate));
        this.logInfo(`ICE candidate added for ${peerId}`);
      } else {
        this.logWarning(`Remote description not set yet for ${peerId}, buffering ICE candidate`);
        // In production, you might want to buffer these candidates
      }
    } catch (error) {
      this.logError(`Error handling ICE candidate for ${peerId}`, error);
      // Don't throw - ICE candidates can fail individually
    }
  }

  removePeerConnection(peerId) {
    const peerConnection = this.peerConnections.get(peerId);
    if (peerConnection) {
      peerConnection.close();
      this.peerConnections.delete(peerId);

      if (this.onRemoteStreamRemovedCallback) {
        this.onRemoteStreamRemovedCallback(peerId);
      }
    }
  }

  toggleAudio(enabled) {
    if (this.localStream) {
      this.localStream.getAudioTracks().forEach(track => {
        track.enabled = enabled;
      });
    }
  }

  toggleVideo(enabled) {
    if (this.localStream) {
      this.localStream.getVideoTracks().forEach(track => {
        track.enabled = enabled;
      });
    }
  }

  cleanup() {
    // Close all peer connections
    this.peerConnections.forEach((pc, peerId) => {
      pc.close();
    });
    this.peerConnections.clear();

    // Stop local stream
    if (this.localStream) {
      this.localStream.getTracks().forEach(track => track.stop());
      this.localStream = null;
    }
  }

  onRemoteStream(callback) {
    this.onRemoteStreamCallback = callback;
  }

  onRemoteStreamRemoved(callback) {
    this.onRemoteStreamRemovedCallback = callback;
  }
}

export default new WebRTCService();
